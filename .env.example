# ---------- The platform console (admin.jharavi.in) ----------
#
# Either name works; set both on Vercel for the same reason the salon app does.
# A localhost value in a production build throws rather than serving a console
# that cannot reach anything.
API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# In production:  https://api.jharavi.in/api/v1  (both)

# Public origin of this console.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# In production:  https://admin.jharavi.in
